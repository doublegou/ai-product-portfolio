# Worker secrets: set with wrangler secret bulk .dev.vars. Never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_TOKEN=generate-a-random-management-token

# Match this secret in Supabase collect-prices and Cloudflare Worker.
CRAWLER_TOKEN=generate-a-separate-random-crawler-token
