* text=auto eol=lf

*.R text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf

*.docx binary
*.xlsx binary
*.gz binary

# Base V3 prepared artifacts are hash-locked and must retain exact bytes.
training/base/v3/folds/*.csv binary
training/base/v3/folds/*.json binary
training/base/v3/folds/*.rds binary

# Archived training artifacts are intentionally versioned through Git LFS.
# This keeps model snapshots available without placing large binary objects in
# ordinary Git history.
training/**/runs/**/*.rds filter=lfs diff=lfs merge=lfs -text
training/base/*/release/*.rds filter=lfs diff=lfs merge=lfs -text
