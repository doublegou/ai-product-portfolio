{
  "name": "pricemapai-web-production",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "dev:design": "vite --host 127.0.0.1 --mode design",
    "worker:dev": "wrangler dev --test-scheduled",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "collect": "tsx scripts/collect.ts",
    "sources:import": "tsx scripts/import-sources.ts",
    "crawler:schedule:configure": "tsx scripts/configure-crawler-schedule.ts",
    "transit:import": "tsx scripts/transit.ts import",
    "transit:collect": "tsx scripts/transit.ts collect",
    "snapshot:export": "tsx scripts/export-snapshot.ts",
    "snapshot:deploy": "npm run snapshot:export && wrangler deploy --config wrangler.snapshot.jsonc"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.0.0",
    "cheerio": "^1.0.0",
    "lucide-react": "^0.468.0",
    "ogl": "^1.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-test-renderer": "^19.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react-test-renderer": "^19.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "wrangler": "^4.149.0"
  }
}
