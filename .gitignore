# R local state
.Rhistory
.RData
.Ruserdata
.Rproj.user/
env/library/
env/offline/
env/profiles/local.override.yml

# Codex temporary working files
.codex_tmp/

# Rebuildable data intermediates
data/interim/*
!data/interim/README.md

# Downloaded raw feature sources
data/raw/features/**
!data/raw/features/README.md

# Base V0 run archive is retained locally/HPC and synchronized outside Git
training/base/v0/runs/*
!training/base/v0/runs/README.md

# Base V1 run archive is retained locally/HPC and synchronized outside Git
training/base/v1/runs/*
!training/base/v1/runs/README.md

# Global High-Sr Risk run reports are transferred as run artifacts
training/global_correction/global_high_sr_risk/runs/*
!training/global_correction/global_high_sr_risk/runs/README.md

# Approved model bundles are transferred as release artifacts; metadata stays in Git
training/base/v0/release/model_bundle.rds
training/base/v1/release/model_bundle.rds

# HPC return bundles are transport files, not project sources
hpc/transfer/*
!hpc/transfer/README.md
