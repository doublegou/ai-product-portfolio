{
  "name": "pricemapai-web-production",
  "account_id": "c1ce7f8d4d7018d071afb6b70f29b787",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/admin.html"],
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": [],
  },
  "vars": {
    "CRAWLER_FUNCTION_URL": "https://uoxeyzowhonxcpcijsbr.supabase.co/functions/v1/collect-prices"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "pricemapai.com", "custom_domain": true }
  ],
  "preview_urls": false,
}
