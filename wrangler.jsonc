{
  "name": "pricemapai-web-production",
  "account_id": "577d30da8b383b03836ca5d57abffb3c",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/admin.html"],
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": [],
  },
  "vars": {
    "CRAWLER_FUNCTION_URL": "https://uoxeyzowhonxcpcijsbr.supabase.co/functions/v1/collect-prices"
  },
  "workers_dev": true,
  "preview_urls": false,
}
